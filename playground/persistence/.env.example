# Local Neon Postgres (neondb-local). Host :5432 is often taken by macOS Postgres —
# use the socat proxy on 54329 (see scripts/ensure-pg-proxy.sh).
DATABASE_URL=postgresql://neondb_owner:npg_local_dev_only@127.0.0.1:54329/claude_code_playground

# Local MinIO (blob-db-local)
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_BUCKET=claude-code-playground
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_REGION=us-east-1
MINIO_USE_SSL=0
