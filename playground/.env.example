# Mac Studio Ollama tunnel (OpenAI-compatible)
OLLAMA_BASE_URL=https://ollama.tokenizin.com/v1
OLLAMA_FALLBACK_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_API_KEY=ollama
# Local examples: hermes3:latest, qwen3:8b, llama3.1:8b
# Cloud examples: gemma4:31b-cloud, glm-5.2:cloud, nemotron-3-super:cloud
OLLAMA_MODEL=gemma4:31b-cloud
OLLAMA_MAX_TOKENS=2048
# Optional: extra skill roots (colon-separated), in addition to walk-up discovery
# NOMAD_SKILLS_PATH=/Users/alexshapiro/starworld/.opencode/skills
# SKILLS_DEBUG=1
# SKILLS_SCOPE=all   # also scan ~/.claude and ~/.opencode (default: stop at git root)
# NomadWorks agents (P2 forks): walk-up .nomadworks, or set one of:
# STARWORLD=/Users/alexshapiro/starworld
# NOMADWORKS_PATH=/Users/alexshapiro/starworld/.nomadworks
# NOMAD_POLICY_MAX_CHARS=14000
